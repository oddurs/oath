#!/bin/sh
# Fast gate. Formatting and lint only, so committing stays quick; the full suite
# runs in pre-push, once, before anything leaves the machine.
set -eu

root=$(git rev-parse --show-toplevel)
[ -x "$root/scripts/task" ] || exit 0

printf 'pre-commit: fmt:check and lint\n'
"$root/scripts/task" fmt:check
"$root/scripts/task" lint
