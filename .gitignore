/target

# .oath/store is deliberately absent: the sworn records are the evidence and
# belong in the repository, the way a lockfile does. See docs/design.md.

# Worktrees live beside the repository, but guard against a nested one.
.worktrees/

# OS and editor cruft.
.DS_Store
*.swp

# insta writes these while a snapshot test is failing; they are never committed.
*.pending-snap
*.snap.new
